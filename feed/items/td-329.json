Ju1MW2ibIE55WpTkoywJhlejxyb2JXWLelCQm8iagNNfA/640?wx_fmt=png","https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEzD0hZYkd53iaHOunETTsC69MRRuz1YHxZMLicWfiamD2EEmvbxJoP96Pow/640?wx_fmt=jpeg"],"video":"","videos":[]},"full":true,"addedAt":"2026-10-13T11:25:20.216Z","content":[{"t":"text","v":"这次给大家带来的大灯拆解，是由奥地利灯厂ZKW（大连锦祥照明）设计制造的凯迪拉克XT6的前大灯。这款车不论外观，尺寸还是配置来说，代表着美系豪华车该有的水平，并且终端优惠幅度还不小，同级别性价比最高。至于缺点嘛，喜欢自己往XY中心拐估计是所有凯迪拉克车主最头(Kai)疼(Xin)的事情了。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaP7hRHI5PjnT4m404yX19xEXDckSNbJyMM5vodRbICjL72vAwmSfsq7eTib27wKrA7Oich8LKVSfHLQ/640?wx_fmt=jpeg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaP7hRHI5PjnT4m404yX19xEBkvQeE97Hb7I1YhNNhxNUYeOPcmtexicBuH5lFDvvRLdvSYMicuUCF6Q/640?wx_fmt=jpeg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaO9mknhAUtKLsFEIiaoQgPprE2gpyiazaCy91xich9lzibfiaibib6vD2R7kdnicR2roeRgCfNPGz2YYtExnw/640?wx_fmt=jpeg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaO9mknhAUtKLsFEIiaoQgPprB4c4aN1QNw7aLeFvFt7NiavHthKlqBePUx5mc6y2w0DvDysic0Uic30cA/640?wx_fmt=jpeg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaMpxejZWoXbwm4zicnIRe62fjcBrrEkzicp73RZBnKltr03f7SkJjg11PD98bfarhxWdPXHwBqc8tvQ/640?wx_fmt=png"},{"t":"text","v":"造型上采用了上下两个亮条装饰，中间放置了3颗透镜，一近二远。从官方给出的信息可以看出，高配大灯是带有智能矩阵式灯光，那么我们就来看看，这个灯内部到底如何。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaP7hRHI5PjnT4m404yX19xEFicom84DpwzGZLM3WXGbudcfibgctKNYIb1lhaIRtRRiaHr3g5gDmVsQQ/640?wx_fmt=png"},{"t":"text","v":"这个灯在拆解过程中，整个感觉就是难拆。特别多的卡扣，而且内部缝隙很小，有些螺钉难以直接拆除，所以在拆的过程中不得不对某些结构“强行破口”，不得不夸一下ZKW的设计还是很扎实的。下面我们就来看一下拆解零件细节。大灯外面罩，PC，双色透镜。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaP7hRHI5PjnT4m404yX19xE63WibJicDozCzyvPhENJm0VjvRPxxAqnRL8JZ4D8JNWoGVFPj9WyTEFw/640?wx_fmt=png"},{"t":"text","v":"主装饰框，PC，主装饰框主要做一个遮蔽作用，内部除了模组部分其他全部被隐藏住。卡扣基本都是被强行切掉的，不然很难拆下来。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaP7hRHI5PjnT4m404yX19xEmsqFnDXic8TRn7nZkq0w7IzMZHA4a2ExhsclyMA2lKmxP1jgXX3LIBg/640?wx_fmt=png"},{"t":"text","v":"装饰框亮条A，PC+镀铝，上面有精致的Cadillac字体。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaP7hRHI5PjnT4m404yX19xEOYt1s9KJkTDZ3pSic9KtBd8ZGvjXAKyxjHtRWznILIMEMa4eicVgGoyA/640?wx_fmt=png"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaP7hRHI5PjnT4m404yX19xESnbvIA09eacY3td3A9qvvibqyj9QaL57BbREZvKXGlwUM2gUs46kWPw/640?wx_fmt=png"},{"t":"text","v":"装饰框亮条B，PC+镀铝，可以看到，正面做了皮纹效果，显得镀铝面比较有质感。装饰条A和B都是安装在主装饰框上的零件。设计比较多的卡扣结构，晃动时无异响。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaMpxejZWoXbwm4zicnIRe62fCpbFA2BS1aeNCkoJhwg4ZUwQaKHX6xJ2sDx2YXNCjFeoB2xjEcTAbg/640?wx_fmt=png"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaMpxejZWoXbwm4zicnIRe62fHJCQ1eIibs0kdxsjThunohibUkEOC2TTJibTAGLlJcRb6hQQkMVL8GjpQ/640?wx_fmt=png"},{"t":"text","v":"拆除一些外部装饰零件后，就剩下远近光透镜，驱动，线束，和一些机械结构了。真是“两眼一麻黑”。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaNbJywTicpiaw67vZJOG3JicYvrH0ZKm96V1QwjoXPXicqzeZia37cdEVp1ROTibTMw7jvibAI4nk5Tl8ic1Q/640?wx_fmt=png"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaMpxejZWoXbwm4zicnIRe62fGqJu2fslN81BJsUsZIBIqHLJElmPPbZULicV1hCqyWuaQkzfI1RNGiaQ/640?wx_fmt=png"},{"t":"text","v":"风扇， 安装在近光散热器之后，用的都是好东西。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEzMhIVFwdXgpGibR3MNM38qv8cX4oY4cGWPcZbraj04bQM34OxicBWRyaQ/640?wx_fmt=png"},{"t":"text","v":"线束，这其中包含了主线束部分和连接透镜模组的部分。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEzDXbGiadjBm0mIOLb1XKcUCeLMYwC4n9LlttSmHa3R00a8tIR7kf7HGw/640?wx_fmt=png"},{"t":"text","v":"重点来了，远光模组，是双透镜组合模组，双透镜应该是为了做成双排矩阵的防眩目效果。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEzXJPqT3FA8ODwzmFiaOb32v2WJHAMO5FLODtw7YiaOZjvG6KsAqJTpgDA/640?wx_fmt=png"},{"t":"text","v":"近光模组。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEzxFIQoiby2YL2C6dOxhNwGppJBazov8rOXRCHQlFibicm7ia3UPXOVc2IQQ/640?wx_fmt=png"},{"t":"text","v":"对于近几年汽车大灯而言，透镜模组已经是大灯的核心部分，不仅承担着主光源的重任，还需满足主机厂的造型要求，照度要求，甚至矩阵光源等等。那么这款大灯的透镜内部结构怎么样，我们往下看。首先是椭球灯罩，非常厚实的一块玻璃，直接由下方的holder卡住即安装完成，无需螺钉来固定的。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEzXibd8JpZ3Ywo5uhH5ZGMO4V38icK8ZKEh4KibKIBmU1IxhCHcvAuQiciaTQ/640?wx_fmt=png"},{"t":"text","v":"Lens holder+局部镀铝，PBT-GF30。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEzgIC28icV2JZXauVzlpHBluics1dbkxDWDiaBWamibgOtXJicCJWIbYBuAww/640?wx_fmt=png"},{"t":"text","v":"分光片。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEzEokEBgpCZ9Ria9Jp1FUQSjDmQk8fj5EhicjiaJ2ibl0e9hxCxUtKicfzxJw/640?wx_fmt=png"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEzwSS9XF8pUT5aQUt3n1gQKyMbasI0zYyh0p4hWNSv4knMZS2ibcEeXWw/640?wx_fmt=png"},{"t":"text","v":"散热块+PCBA。这里就看到核心部分了，一侧PCBA装有11颗LED，另一侧装有5颗LED。板子直接贴在散热块上面。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEz8lAZfv9BhmatU4FaxGjib0GibO1UJ4nrdkSWLu6RRAyTprsaOQV9XkwA/640?wx_fmt=png"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEztBnTnGd9GuV7EoMibicmyNvZ6KgAxsZjMw6oiam03RBD2LKr9TRc5oia5A/640?wx_fmt=png"},{"t":"text","v":"内透镜A。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEzw1UncPlajcpmrgGXeGnzfqHtjgfjqyf9iaab4XFQyr24eZp31g4mkPQ/640?wx_fmt=png"},{"t":"text","v":"内透镜B。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEzlSzujE08UTC42ZVKPGjmwgiahMKdFNSW6BhuXj1AWSqFLLtvbxxUq4g/640?wx_fmt=png"},{"t":"text","v":"整颗近光透镜的全家福就在下方图片了，多拍了一个装饰框和一个透镜支架。其实零件并不算多，这也是目前透镜的发展趋势，数量越少的零件在成本上才能有优势。但整个透镜其实重量并不轻，尤其是玻璃材质的灯罩，在轻量化要求的今天，是否可以考虑可以用塑料灯罩来替代。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEziaynbtUaUia2utKTgtIcMiciboqFibunjTJib5eIS45WEtGpibdslCJ53l8NA/640?wx_fmt=jpeg"},{"t":"text","v":"接下来咱们看远光两颗小透镜。模组透镜x2，应该是一模一样的两个。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEznsmgoJLqmuSa0rL5KGRforXdjU0UcBVHSupWxjceNiaGUia62xqj0TDg/640?wx_fmt=png"},{"t":"text","v":"透镜支架x2，PBT-GF30。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEzkjVgibybFHsIVeyFJSxyS3ENFWwRYSJXSC01uKmSZIAS5hFZNAVwiaXw/640?wx_fmt=png"},{"t":"text","v":"散热块+PCBA，每片PCBA上共有8颗LED，所以小编大胆猜测，大灯应该是两排16像素的矩阵大灯。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEzBF8EHfgt0QrJu1MW2ibIE55WpTkoywJhlejxyb2JXWLelCQm8iagNNfA/640?wx_fmt=png"},{"t":"text","v":"远光透镜全家福。零件也是非常少了，当然透镜线束咱们就没有放在这里了。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaPfmpNLybMCHHl1rGHjTqEzD0hZYkd53iaHOunETTsC69MRRuz1YHxZMLicWfiamD2EEmvbxJoP96Pow/640?wx_fmt=jpeg"},{"t":"text","v":"最后，XT6前大灯的拆解就到此为止啦，出一个小题目考考大家，内透镜A和内透镜B的作用是什么？欢迎大家在留言区告诉我们答案。而且看官老爷们如果有什么意见和建议，或者想说的都可以评论留言和咱们互动哈。我们下期再见。——The End——"}],"coverImg":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaP7hRHI5PjnT4m404yX19xEXDckSNbJyMM5vodRbICjL72vAwmSfsq7eTib27wKrA7Oich8LKVSfHLQ/640?wx_fmt=jpeg"}