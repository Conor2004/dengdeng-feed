ow1vkImeRZ4LYiaeIIOoDficbQVReHZhCP5eEcTXibSW3M1Tc69icyAo77Ycrp12IqNiclg/640?wx_fmt=jpeg&from=appmsg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyGv7xSArwow1vkImeRZ4LnlRo2R1CB5FlL8RHyorLtAX0nSnS3EpId3HTG4zKPtPoiaxKo2xCevg/640?wx_fmt=jpeg&from=appmsg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaNyGv7xSArwow1vkImeRZ4LS1IbsxkRWLxZ7pX54I8coJ52Rpl84I82pOdC8pVDCdEq2GONRU3x5Q/640?wx_fmt=png&from=appmsg&watermark=1"},{"t":"text","v":"CS75PLUS是长安的当家车型，销量一直不错，今天我们一起来看看他大灯的庐山真面目。外侧主装饰框包含多个信号灯的内灯罩，正面目测至少三色注塑。但看背面有很多的卡扣结构，灰色的装饰件、镀铝件等均是卡扣紧固的。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyDrp7YPiaZCXKVZHmZLuXCSKJUWzvicgg0iaxlTnce6k5DIibh6dZtdib5iaAA/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyD3jYdADusKjBEZDlPbHiaLoq63YMMGYcAshkTTGiaPM0yBd3iaCqvjSVibQ/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyD5N8MPaDAfRicdiatbp4cBOJibdLrgHSwMWBY39FHavbia7Jaicv9dZaybQw/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyD4uUUGTBXdmwe8szN8JQgcHeibQLVWYuFo7CQfQaSW5vsXFHOXRaNLOA/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"拆开主饰框后，可以看到下方是多根光导组成的信号灯以及对应的白色支架，我们拆开看看。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyDNZvnqMoPC8cbLDqeXDuickibLRFAZSxyKgiaqMse1TC4icF5DP83Wbvd5w/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"四根光导对应3块PCBA，其中两块是单颗Led对应单根光导，最上方的光导则对应3颗白光+3颗琥珀色Led，做日行灯和转向灯。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyDpAMTST2q6Uiacc089Tg9wrWXS3cGD6WJ7VfOWZR7srqhI9icZ8bbmD2w/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyDcfFIfRv74xnEBd64eHO6NTVmL5fnrmsfgAUo2gALM1uAM7kVAFiaYnQ/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyDckNKyqyAJ7xvVR5FKzuY0hFQ3KohnvYMvqklLmrJ0ap3mZL1eMX0icg/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyDiaH43My4hDMao7ZLlw7W3revOH4w4qNiabibL463XHciaRhTd7Bko1hghQ/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"这里有个很有趣的设计，光导虽然在光导槽里有限位，但背后远端的固定是靠一根支架。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyDr0Tll7sibtUdkHWmgHQQkZWUBC7NgVOuDWSVxziaBGibiazEFuYtglkbHw/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyDFNXftDOTW3mtH97RIPm162jF1XlMj4V7W7rSylfQwjLj7wDTts6EsQ/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"最后，我们来看透镜部分，这个透镜是个尺寸为30×120的双光透镜。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyDO9YbSrwqfEicMFf5Kw2qL4rAnp2QRXZnIU8OCv0b2b9sJQWCI8AwpgQ/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyD79PqKy64Hx6dVLhBvWDPmAyl4Q9gsggoibPTbMZZeeGuETXGABE5nOQ/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"这里有个很奇怪的设计，就是透镜的lens和底部的腔体不是平行结构，而是肉眼可见的歪了一点。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyDMzWUJw0vn5NybicwkKuGG2zSRxUaQicoaKackmSx1aiapUCGsG4zCZsmw/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyD5jica4YIib24hEUNLHKxRaIiarTwV0fwZJBmdBPcHibXZ6ZTtkeXKXGzEQ/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"而且这个lens的固定也很特别，采用的是金属片固定。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyDw0m1bMPGot5kj1rczH7sAXWWFpbicgl7d0sPMjk75h3qNY91Y7iaOsYw/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"看看透镜的光学设计。一共5个Led直接安装在散热器上，和PCBA用金属片连接。前方有一片金属片，从形状来看推测出这是用来做近光截止线的，也就是说中间三颗Led是近光，外侧两颗是远光。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyDaDDKd3W2SjI85m06zCJpccibt8DoC1ZyDPGrsejOFqUQ9che2caJ6Ng/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyDL8lU7qFFUN0KWDUCU1ORLAffYPhBw7mknd6dAKPFvrqoZwkqYBLufg/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOrH1yF3gasV6ocr4AkNAyDD6LJ92zdsmSze5FPia8iakuX2QW0ZOOvkk9YbrhePsdicZ7nDBbiceHINQ/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"最后，我们来看看驱动器，"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaMCtUAt09rufCkJ3wRq66CA72LGrYiaiadCAsnACKOZ94YHB3aVW7OSEjbjBpIusvgdcwqljOPldbBA/640?wx_fmt=png&from=appmsg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaMCtUAt09rufCkJ3wRq66CA0eY51f3ExUouv1xQPelghRoXB8b3WgnhYab8hVhAfuyYGGMYajbsvQ/640?wx_fmt=png&from=appmsg&watermark=1"},{"t":"text","v":"CPSQ5453是来自易冲半导体的一颗汽车级电源控制芯片；双通道且通道之间可独立运行的恒流和恒压电源控制芯片，可运用于传统前灯（日行灯，前转向灯，前照远光/近光灯，雾灯等）以及智能前灯（ADB矩阵大灯）等应用中，具有以下优点：广泛的输入电压范围和灵活的电源拓扑支持：支持4.5V到65V的输入电压范围，并能够控制BOOST、BUCK-BOOST等多种电源拓扑，适用于不同应用场景。高精度电流控制和快速响应：采用峰值电感电流控制技术，具有较快的响应速率，同时在低电流工作场景下具备电流误差补偿功能，保持较高的电流精度。完善的保护机制和多种工作模式：具备包括过压、短路、过流等多种保护功能，并支持多种工作模式，如正常模式、跛行模式，以及通过OTP寄存器烧录实现的独立运行模式，确保芯片的安全性和功能完整性。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaMCtUAt09rufCkJ3wRq66CAvIrziafuOmZ02aMQZuvzHzyTZyho9VTu3dODl2AdicvXe4JfuQCibK6eQ/640?wx_fmt=png&from=appmsg&watermark=1"},{"t":"text","v":"CPSQ5352是易冲一款专为汽车应用设计的独立双路同步降压 LED 驱动器，具备4.5V至 65V 的宽输入电压范围。采用自适应导通时间平均电流模式控制，确保在广泛的输入电压、输出电压和环境温度范围内提供 ±4% 的输出电流精度,支持模拟调光和PWM调光技术.CPSQ5352提供了多种保护功能，包括逐周期电流限制、过热保护以及故障监控与报告等，以增强系统的安全性和可靠性。CPSQ5352的SPI可编程诊断功能，可以有效地监测并保护系统免受潜在故障的影响，同时支持Limp-home模式，即使在发生故障时也能维持基本功能运作。CPSQ5352符合AEC-Q100准的特性，能够在-40°C至125°C 的工作环境下稳定运行，适用于汽车前照灯和自适应 LED 驱动模块等应用。其封装形式为HTSSOP-32,顶部散热焊盘有助于提高散热性能。两颗IC，共同搭建出适用于ADB大灯的车灯系统，一步到位直接驱动LED灯珠。先用升压IC CPSQ5453得到比较高的电压，再通过降压驱动芯片驱动LED灯珠：满足远近光多串LED高电压大功率需求.易冲双通道升压IC CPSQ5453既支持CC输出直驱LED灯珠，也支持CV模式工作，通用性好。两个通道完全独立，可以各自工作在不同模式。易冲双通道降压IC CPSQ5352集成了MOS，降低BOM成本。输出电流精度高，调整响应快。最后的惯例，车灯是由马瑞利生产。"}],"coverImg":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyGv7xSArwow1vkImeRZ4LYiaeIIOoDficbQVReHZhCP5eEcTXibSW3M1Tc69icyAo77Ycrp12IqNiclg/640?wx_fmt=jpeg&from=appmsg&watermark=1"}