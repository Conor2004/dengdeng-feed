B5yJlvP80bfnYE71YhaNqY3PuUdaPIW4xskG8fWQ2sVQ5adpw2vG57zp3RUaBXvuscVGxg/640?wx_fmt=jpeg"},{"t":"text","v":"整个大灯最核心的部分就是这4颗透镜小总成，信号灯和主光源均集成在这个小总成之上，所以我们直接从这部分开始讲起。这个透镜总成非常的扎实，虽然看上去所占体积不大，但包裹了主线束和很多小的塑料件。接下来我们一一给他拆开。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOFhs07ZdIn560Ciay2FUKP9hEXmOnX7bYZMGbZEFicLrBFKMjlSaI4AYkrbfkJFZF0qTajLJmrJnRA/640?wx_fmt=jpeg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOFhs07ZdIn560Ciay2FUKP9kJrbQdQVDNLf9IT2HNOzNMkz2pIklaPtTjF6sO7I1zNU6MZkGciaibYw/640?wx_fmt=jpeg"},{"t":"text","v":"首先是最外侧的线束加支架，可以看到主线束有两个主要的连接器，除了常规的主连接器，还有一个泰科的连接器。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOFhs07ZdIn560Ciay2FUKP9Ih5cnUgcC9wDdLt9wgibKicajiaDStht4SvCnL1bKlzev0HibGwa3vZyoQ/640?wx_fmt=jpeg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOFhs07ZdIn560Ciay2FUKP9oa2Lcw5pt2VlaKyqKdLqH7Z5VyyDCVmxlTzEzRQNOxfiaoHj7tDamLQ/640?wx_fmt=jpeg"},{"t":"text","v":"支架上还有两个风扇，对应在下方两颗透镜背后的散热器上。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOFhs07ZdIn560Ciay2FUKP926vBvCzJg1L78uNMYdo1ZpDvwmicRgVvzUvIVHAHlkReQLMQ5CY07iaA/640?wx_fmt=jpeg"},{"t":"text","v":"这个风扇的设计很有意思，固定风扇仅用对角的卡槽和一个软胶扣，没有螺钉。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_gif/bfpNckwxSiaM5tzHb0YwAXtEjStqicoLxWFHaGgicENYnl5g3208FHtmOG25WhIclIXCGdv02dPPUJ9Q3D2vvczsQ/640?wx_fmt=gif"},{"t":"text","v":"顺带我们还把上方两颗透镜上边的眉毛盖子给拆了，可以看到眉毛的效果是由光导实现。这下整个透镜小总成就很干净的展现在我们面前。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOFhs07ZdIn560Ciay2FUKP9mdpjOqM5XXfDa8nEHiaHr5brLhHl7XEucZPf9fOgQzKG2MNsvsPlygA/640?wx_fmt=jpeg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOFhs07ZdIn560Ciay2FUKP9f0RAkyichWBbcF6eLeRc01Had9ovOLYGhicaKO545AToJHHIunSTNZIw/640?wx_fmt=jpeg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOFhs07ZdIn560Ciay2FUKP9UKniaqWibtZnD1ibJoWdic8bBdQvFQ5LrCCwmialomNyw4LcGBc2sH5lMkg/640?wx_fmt=jpeg"},{"t":"text","v":"我们先讲下方的透镜装饰框拆下来看看，因为上面集成了一个非常异形的角灯。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOFhs07ZdIn560Ciay2FUKP9pDUjgY8O5hP2sxV1DXZAJk9ldunlELNJfLiaqr5hias49ic81UqYSQC7A/640?wx_fmt=jpeg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOFhs07ZdIn560Ciay2FUKP9ZykfX9zTRO4Ol3eUehAGl7axQ9OO2XyDwnriawRibzlIzibDI4CDC4FGQ/640?wx_fmt=jpeg"},{"t":"text","v":"这个角灯由一个扁长异形的散热器扣在支架上，然后由一个灯板加聚光器组成。这个设计非常的巧妙，节省了不少空间。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOFhs07ZdIn560Ciay2FUKP9D8aeXDh3CJXC4ibe6gDSGZQMwicTrNKFuBCOepdHEiaR45veWbm7qIMXg/640?wx_fmt=jpeg"},{"t":"text","v":"接下来看HD主体部分。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaO6VlN1B5yJlvP80bfnYE71sllP36GpFwh3iaiaR29Qib9L3Ef37PlevbME1fmknUeS8FbjU3zGf7XMA/640?wx_fmt=jpeg"},{"t":"text","v":"这就是其中一颗HD透镜的小总成。大体可以分为上方镜头总成，中部白色的支架，底部光源加散热器。咱们先看镜头部分。下方是镜头的拆解图，可以看到简单一个镜头有4层玻璃镜片，然后有各种支架垫片，总体来讲还是挺复杂的。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaO6VlN1B5yJlvP80bfnYE716PRSHC4fpRv8GIiazv9XGWTT0AHlQtIN4qC8u9ZvlYt2VGBVhJKdChg/640?wx_fmt=jpeg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaO6VlN1B5yJlvP80bfnYE710HsPrcTMd5ia8gX2VS7OFbBrFXaETZUbyKRpaOS4wwpXib4zVp4XGqbQ/640?wx_fmt=jpeg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaO6VlN1B5yJlvP80bfnYE71nz9poHA26vMtlGe1fFxkWDPufSxjltPv5yM4zkJTcWwKz0NHiaFFKxQ/640?wx_fmt=jpeg"},{"t":"text","v":"对比两颗HD透镜的镜头部分，可以发现两个镜头的长短和内部结构是有一些差异的。功能上一颗负责远距离照明和投影，一颗负责近场投影。附上另一颗镜头的拆解图。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaO6VlN1B5yJlvP80bfnYE71bIj1jhIaSvNiaibBaDo12YVA0r7jkiauSSRGTHwgIjboQRZ2LSTIAOcaw/640?wx_fmt=jpeg"},{"t":"text","v":"白色支架部分是一分为二的，一个连接镜头，一个连接光源。而两个直接之间采用密封胶封死和固定，镜头方的直接连接在主支架上。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaO6VlN1B5yJlvP80bfnYE71W47LibZibbMLM6evmBSojqsPraIgXRkZLYoQUvPDpRl7H4n73kzhaJHQ/640?wx_fmt=jpeg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaO6VlN1B5yJlvP80bfnYE71Gibj8TQZSRnt49z23C1ZG9FkDoVaRG1pwXTdq3k0WXBibWvdicUqNUiayg/640?wx_fmt=jpeg"},{"t":"text","v":"这么设计的逻辑是什么呢？在调光的时候好对焦，对焦通过后“水泥封心”，固化光源与镜头的相对位置。然后再固定在大支架上。其实四个模组装到支架上都没有常规的微调结构，都是模组总成装配线上光检确定位置后用胶固定。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaO6VlN1B5yJlvP80bfnYE71cwy3oJLISSSDzUMPVGGb3B06eQhxAxw0dzPjdxfQsNjVq8aac8jZug/640?wx_fmt=jpeg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaO6VlN1B5yJlvP80bfnYE71ibsP0jyJylhQnFNumicBn1oEGDcvBu41VdsSiclIuJcxBTShglyEHbAwA/640?wx_fmt=jpeg"},{"t":"text","v":"在附上光源部分的照片。16,384像素的LED尺寸特别小，来自日亚，两颗HD光源部分一模一样。一个HD透镜具有5°x20”视场可提供 750 流明和 125.000 坎德拉; 另一个HD透镜具有 10°40°视场，可提供 800 流明和 12,500 坎德拉。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaO6VlN1B5yJlvP80bfnYE71ztTD6ibcP9PwvLFG8e7PwOJoI6VRBoqlgDPoVlUYPFr0tNQS1t2wdUQ/640?wx_fmt=jpeg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaO6VlN1B5yJlvP80bfnYE71jIQwFMIQg8zyQnDJqQxJh1KMZyUsMd16UYWombnX41EWcibzFP3kiatQ/640?wx_fmt=jpeg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaO6VlN1B5yJlvP80bfnYE71zr2faicEs0o3waAo52gJ0icy5Jf5Ag5icStvhu0eDK76dEKNMpEOkPK4w/640?wx_fmt=jpeg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaO6VlN1B5yJlvP80bfnYE71yruofKLQqGIlpxxQa6H8f8muTDw9wswc2wpGjNPRns1q5byYWCFiaibA/640?wx_fmt=jpeg&from=appmsg"},{"t":"text","v":"除开两颗HD透镜外，还有两颗双光矩阵透镜。双光透镜一部分组成了近光，而且只是近光截止线水平以下部分，水平以上由HD组成。该模组另外一部分组成矩阵远光，只是led数量减少，更精细的矩阵还是由HD来组成。四个模组的散热器都是低成本方案，不是压铸冷锻这类甚至热管等，而且采用铝型材工艺散热器。整个HD大灯的拆解到这就结束了，作为大众家族的豪华品牌的旗舰车型，大灯采用如此奢华的配置还是值得的，HD的加持给予了车前更安全的照明，也标志着欧洲前大灯的技术正式由激光、DMD等转向HD，未来也会有更多的欧洲车型量产HD技术。最后，这款大灯来自海拉，MicroLED来自日亚。"}],"coverImg":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaO6VlN1B5yJlvP80bfnYE71SWMJZVIOd9CcgVgPrXcVBDeBkQnOX04kNZZRQn6mPOHVVsctqaLGiaA/640?wx_fmt=jpeg"}