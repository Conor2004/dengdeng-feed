4I8XJ63iaw75fTHgibL4Jq6tPTDLM20Q88wBJ0nFH5aaljBXWEwnagTtMVtaQ/640?wx_fmt=png&from=appmsg","https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJicxAnwpomDPQ2ledibiav9qxAYAb9sW8CTzYESqIibUGpHasGPU9NPVb0A/640?wx_fmt=png&from=appmsg","https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJpPT4wFv6HcTbOVJLXIOYLibygVXVocBP5KZPGqNEgW1MAaAOW4VVxfQ/640?wx_fmt=jpeg&from=appmsg"],"video":"","videos":[]},"full":true,"addedAt":"2026-10-13T11:25:09.145Z","content":[{"t":"text","v":"继上期拆解一代大狗后尾灯，本期咱们来拆解二代大狗的后尾灯。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJXc7g4gI18tRPMwIuNA9UiclCBacCQcxYMpKabRDrpKfVyJNvxjepAGw/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"二代大狗后尾灯采用圆形设计，与前大灯的圆形设计相呼应，复古又时尚，使整车风格统一。灯内有骨头形状，与狗系列名称相呼应，体现品牌特色。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJlGhgBFXmd8aE9icGBDbvmyib4a9Wun1Gp6N0BicqzIgU9T8K1TXr4d9Ig/640?wx_fmt=png&from=appmsg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJiclfZ3ttPyIU2hOuKIiaZKhIoe4j1eVUJDt5O3WUMaa0eXmmxVjCTE9Q/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"二代大狗后尾灯没有采用贯穿式设计，而是采用直线与圆形的多边形搭配，增加了辨识度。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJ7AfboONDibAmnCw6EbNpGzKibEcH5nTPLzicGDqgJhic6IibR7WZqicBVm6w/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"后尾灯拿到手里的感觉就是一个字:“沉”！这个灯不大，但是比笔者接触过的大部分后尾灯都有分量，粗略的称了一下，大概有2.4kg。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJAXniaWJcjMqvDM7QKNcHM74erDOQ77CrpybrHzAcmdkrTmy0Q7jnkqQ/640?wx_fmt=png&from=appmsg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJNK6ROqVl9tZricSt0M1owcyVibFLiaia28z0kX0pjoibRmI3VYkuSxrxWng/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"那么让咱们进一步拆解，看看内部究竟是什么零件那么有分量~灯罩和灯壳是热板焊接，灯罩与灯内各零件的距离格外紧凑。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJpa7gbgrMTEYs5Y7NohbF1GkMtVglTm2QKqrGlADaWjyPMibsaFTY1gw/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"为了保持各零件外观的完整性，尽管比较耗时，还是必须一点点的切，一点点的拆。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJzxq7lTF6KYViaxTk0l541l4VYic95Qg48VCv6w7oO8g4iaHVsLH4icW1Lw/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"基本完美分离！灯罩为红黑双色注塑成型。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJibza3spJp0icxRLSGbY9p0XTuhgoCauQH9ia7d89DII3TCCTYwYr4v3Dw/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"不得不说，灯罩用料很足，拐角处厚度达到6.14mm，内侧尾部竟然还有加强筋！这绝对是越野车的强化设计!整灯背面，拆掉边框，"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJ8btytNDIrK7icMx3AhGrdDboUhJdibgicK6Uy9xmEBR5P7zqrTPxWbJrA/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"和一代大狗相同，二代大狗的边框也是全周包胶。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJec3ZZaSicCOk1cl1EOlXJkDNn1Tqa5RxnSmKXhPvlaicqlyqibKFziaVyA/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"整灯背面，两个呼吸帽和一个透气膜，热交换用，防止进水起雾。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJXawHmHCMEkicLka9BCgKSwtHNgKP2KOGhPicF7ap0u2tLUoHWeO396Mw/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"厂商logo，没有悬念，曼德光电，"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJd3BVcicTHe8INporBoUeskIYuvaFCnHciaucXOFQDaF35uNo0PEe3Qkw/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"车灯生产信息，车灯全周还有6个防止与车体干涉摩擦的缓冲橡胶块。左边的圆形贴纸一代也有，应该是退火完成的标识。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJvLGk2qLW47RN0Nyw5I3aZ6Y1CuR6AETDSQLibg2bA71QhUKvMRuJ6Hg/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"圆形的防水透气膜，防止尖角处的狭小空间聚集积水气。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJmRsichgsiaokyo36Ric05Owl0GyE1OdBsRA2uStfrNxnSnlORIPemKbqQ/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"拆上沿的支架，"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJzicH6lt1OnrVDpcvVEibrYqMtWYDUSeibWdK847OSydPSUqCicVCXD6U1g/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"这个支架有连接加固的作用，是否还有遮光的功能？"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJiaics0Zj1eBOYyQJQOcFa0icicnIXoJ3WpL1TCsdqtRaHgGLECzemqQPXA/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"将正面看得见的螺钉和背面的密封螺钉全拆下，"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJ0sIPLHy5HHOypINPbvSzMFBOj5iaTC5rp9HTg0rTGGMHgyyKSPSH7Jw/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"分离灯座与光源组合，"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJNZDXcOLee3cCCH2lBIl37eyTvnAu33xD0VoT9LXianw0WibYawUmB16A/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"光源组合的四个视角，原来灯的分量都在散热器上了。环形光源，主控电路都有相当分量的铸铝散热器，"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJztxvRUxhXP9PsFLmIOtpn8WduFibXAF9Es4rzdaBAb2hiabiajM5GkfSw/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"进一步拆光源组合，"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJklC1O8mYKW4bsvPP1Aia7iaxbL7R8MyBDwFcardVek7SJ7M7Wy4JViaUg/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"拆下主控电路板，"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJdZW2Hg76qOKvb0Vb6PRmkLibfDOT0mZCGSIfJdcZHEF2fNUSUuFj9IQ/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"再拆散热器，TURN/TAIL光源固定在该散热器上，"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJ1JVFqiakgHEZDicQibGHtaUU443U9ibpIzlibhcmBkYXzWtM1kyFGmFfUqQ/640?wx_fmt=png&from=appmsg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJBsO6hy5ibDMH1ux3xIkZQzgicmxlyyhMkic7ibqX8XjwHm52uc21shPWFw/640?wx_fmt=png&from=appmsg"},{"t":"text","v":"主控电路板(正反面)，"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJS6by0jAZH1AMEHOnGZpYMmywwMlsaNKGOtktdLMtibcOGxL8HH39l0w/640?wx_fmt=png&from=appmsg"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_png/bfpNckwxSiaOS4iawE7k4aPFibARAp4I8XJUhCWGZ5d8CMKuvfphsj7nVtDvUTxicNkcqhHHoXaY5IQntWBZiclHJ8A/640?wx_fmt=png&