cn/mmbiz_png/bfpNckwxSiaN1mOtKpD5IYLFJNqlBDEcHCFjeUmPhMxqfg0FAFLSJD49J0l6QI3b6IuWD0y6ONSVibJmxVrfOsgg/640?wx_fmt=png&from=appmsg&watermark=1"},{"t":"text","v":"话不多说我们开拆。整个大灯尺寸非常大，毕竟有半边车宽那么长，重量也是非常大。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaN1mOtKpD5IYLFJNqlBDEcHTg0OuAULS9nWNq1C4GqOvYneXoPukH9iaicVEMLMstP3FuUsvREUynUw/640?wx_fmt=jpeg&from=appmsg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaN1mOtKpD5IYLFJNqlBDEcHDvDUuemxYkuWedXaNicPsQ6d9oUuiaYgKEtWuArZiaguzQoIePeMXDYww/640?wx_fmt=jpeg&from=appmsg&watermark=1"},{"t":"text","v":"有密集恐惧症的小伙伴注意了，接下来的拆解画面可能引起不适。开个玩笑，确实密密麻麻的透光孔太多了，LED颗粒也是整整齐齐的非常多。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2P1YfFKGuyPMv9CxlmQuBHj6OpKH0EBmTXeyQBTKwCNk26iabnO8Yqbg/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2YrlCoSZibYmewC0lmg3uUic0aV1WrKCmoNd1Egz9jyLDMF4Kq3nPgibtw/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2EtQ8A9aIibq3dicY4Og9vPtAnMNuAoIJym5dWN76ANpNiahvzOTuPORiag/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2gkz4p7zehNHibderyjVibVCh6YraXP89Buehq7dyCh7pQJGvs9wRvicWQ/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"细数一下，透光孔一共有16×228=3648个，LED颗粒数共有828颗。那么为什么会这样设计，我们往下拆。有个特别的设计，每一块LED板子的下端都有一个长条塑料铆接，原因应该是防止一条条的pcba翘起。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g27jBOBPG2oeNo4wficGZUhw8VicWcXC29TsmnWuiaODl50MCCIHN0Eu5vg/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2HTZVhogOz7sSZDOlibjeBOH5DJnyQsHQVKtd17icnVs0LF5q4u1LNiaKA/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"拆下这些灯板后，可以看到下方有5个驱动板，全部由金属外壳包裹的严严实实。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2BPFTv3v8AFp8BZF4fOMuOxpTraA0V52Sws7a7XV86v2J0rAPb3w70g/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2Jdib8gK9xNvBDPRiaEiabd9cbb87tRzEgO0Jf51MwH3MWmWWsiaIgz8wJQ/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2whPic9icfibnCk4ngQ4BSKC33TJfqmwj5RSHrPZQfLlZN0QGTj16tCnUA/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"剩余的部分大致可以分为两块，信号灯半总成和透镜加壳体，咱们先看信号灯这块。壳体上还装了一个驱动板。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2TmfaxZyibuY9pdrRGS1subvXTozkibtmT00huzlamEkuMGKVYZS5tGqg/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"信号灯半总成上面最显眼的是厚壁部分，虽然没有采用极端的双层厚壁，但也是x向非常长且带阶梯的设计。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g23ucNSjgb79n4HGQdBHUGYy3QDNMfb6aWNDbvgicHdaovOYrG4t5D5Tw/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2kJaPHLiaia0JYXBcHticYtXPJQIOK2VWHzrXN3aVBSmG3NCnaR8zvq6eg/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2TJicCdMh8zMMthyziaUE7wQ97no80vnQicxlvIU5uuqSzeIXsqOgNicGOQ/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"上方由三块灯板组成信号灯，左边两块白光和琥珀光，中央仅白光。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g23xv4EzXicndxv21F9cNvktxjEuSPvicPibRxf9gMNTbKpS1SoDM8agCvw/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"最后，我们来拆透镜部分。透镜是一颗15×200尺寸的薄透镜，使用窄模组的目的就是淡化主光源，并且这个薄透镜的安装深度也是非常深，正常角度容易忽略。就连装饰框都是全黑，没有任何的表面处理。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2vVIU5gZYgKgdndhQAkUkrIQibvnuribzS7hoSax1VibLaBlbaWCKQ0LwQ/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2phApOibJtuQDD00Hwnp3lGQ4FK63wDoCL4llCyJZZCEo7fcicuba5Uibw/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"这个透镜总成基本是一身黑的设计，即便单看也非常的帅气。整体非常的重，其中支架就用的是铝，有点过于扎实了。上面还有个风扇用于散热。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2TWFa9FZMaBPPhZ4Y0U05wdVPtgjt4EKlkPXCCqtxyfAcNh1L7ppF8A/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2Lv6wvvP5mkxhRTddiapZ1uMY4UySBA14ZNx4rykgYCQFn2ugSNALeEQ/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"窄模组除了透镜外也是一身黑，从反光碗的数量可以判断远光是有大约20个分区的矩阵。薄透镜用这么多分区，设计上得把效率尽量拉到极限。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2223Mg6H2NhRFUNF4mk3bEkwTQyvugicWCoPenFaicJqbZHF3Y9XRcDHg/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2sDMKBJ9NdFzPGr2HcvyIC5v7N2NZs2q5GybicYnibA5n2eUFSH6oTASw/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"这里有个有意思的设计，近光反射碗和远光反射碗不在同一个边，为了保证“造型”好看，反射碗还是用的局部镀铝，pcba也是黑色，真是极端。"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2R0OspkPUvxQQibeiayoPbfguX4qxUfDUmibECcEaJ7UVljIPZHMUWswFw/640?wx_fmt=jpeg&watermark=1"},{"t":"img","v":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaNyibBlpsI7mFrnr4ErEo6g2a0j3H8HEuDptP09IZQ3AG6HlicV8VABEAQA04Via2c1TuGavBsQpLYMw/640?wx_fmt=jpeg&watermark=1"},{"t":"text","v":"那么拆到这里，这款007天幕大灯也差不多了，那么解答一下为什么仅800多颗LED要对应那么多个透光孔呢，实际上这是设计师追求的一种水墨画的效果，要的就是串光，模糊化处理。如果要清晰的交互屏，可以选择7x的大灯。整体来说，这款大灯确实符合吉利爱灯的特点，配置用料基本拉满，灯厂的设计也十分扎实，小编拆的非常艰辛。最后，这款大灯来自于法雷奥。"}],"coverImg":"https://mmbiz.qpic.cn/mmbiz_jpg/bfpNckwxSiaN1mOtKpD5IYLFJNqlBDEcH43IoqDuQgBn002fyE4NQKiarcHIbFFIodPl7TLbkMdFk7dXJ9pHIAibw/640?wx_fmt=jpeg&from=appmsg&watermark=1"}